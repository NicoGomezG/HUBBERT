generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Usuario autenticado vía Discord OAuth2 (Supabase Auth).
model User {
  id          String   @id @default(uuid())
  discordId   String   @unique
  username    String
  avatarUrl   String?
  createdAt   DateTime @default(now())
  lastLoginAt DateTime @default(now())

  memberships        GuildMember[]
  embeds             Embed[]
  birthdays          Birthday[]
  reminders          Reminder[]
  ticketPanels       TicketPanel[]
  reactionRolePanels ReactionRolePanel[]

  @@map("users")
}

/// Servidor de Discord conocido por la plataforma. Existe una fila
/// aunque el bot ya no esté instalado (botInstalledAt queda null).
model Guild {
  id             String    @id
  name           String
  iconUrl        String?
  ownerDiscordId String?
  botInstalledAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  members            GuildMember[]
  settings           GuildSettings?
  embeds             Embed[]
  birthdays          Birthday[]
  reminders          Reminder[]
  ticketPanels       TicketPanel[]
  tickets            Ticket[]
  reactionRolePanels ReactionRolePanel[]

  @@map("guilds")
}

/// Relación usuario-guild + foto de permisos tomada en el último login.
/// No es la fuente de verdad de autorización: ver packages/discord/permissions.
model GuildMember {
  id           String   @id @default(uuid())
  userId       String
  guildId      String
  permissions  BigInt
  isOwner      Boolean  @default(false)
  lastSyncedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([userId, guildId])
  @@index([guildId])
  @@map("guild_members")
}

/// Configuración general de un servidor. 1:1 con Guild.
model GuildSettings {
  guildId          String   @id
  timezone         String   @default("UTC")
  defaultChannelId String?
  ticketCategoryId String?
  enabledModules   String[] @default(["embeds", "birthdays"])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("guild_settings")
}

/// Embed guardado y reutilizable de un servidor.
model Embed {
  id              String    @id @default(uuid())
  guildId         String
  name            String
  title           String?
  description     String?
  url             String?
  color           Int?
  authorName      String?
  authorUrl       String?
  authorIconUrl   String?
  imageUrl        String?
  thumbnailUrl    String?
  footerText      String?
  footerIconUrl   String?
  showTimestamp   Boolean   @default(false)
  /// Nombre y avatar con los que aparece el mensaje. Si alguno está seteado,
  /// el embed se envía por un webhook del canal en vez de como el bot.
  senderName      String?
  senderAvatarUrl String?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastSentAt      DateTime?

  guild  Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [createdBy], references: [id])
  fields EmbedField[]

  @@index([guildId])
  @@map("embeds")
}

model EmbedField {
  id       String  @id @default(uuid())
  embedId  String
  name     String
  value    String
  inline   Boolean @default(false)
  position Int

  embed Embed @relation(fields: [embedId], references: [id], onDelete: Cascade)

  @@index([embedId])
  @@map("embed_fields")
}

/// Registro de cumpleaños de un miembro del servidor.
model Birthday {
  id            String   @id @default(uuid())
  guildId       String
  discordUserId String
  displayName   String
  day           Int
  month         Int
  year          Int?
  channelId     String?
  customMessage String?
  imageUrl      String?
  color         Int?
  isActive      Boolean  @default(true)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guild         Guild                  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  creator       User                   @relation(fields: [createdBy], references: [id])
  notifications BirthdayNotification[]

  @@unique([guildId, discordUserId])
  @@index([guildId, month, day])
  @@map("birthdays")
}

/// Registro idempotente de una felicitación enviada. El índice único
/// (birthdayId, notificationDate) es lo que impide el doble envío.
model BirthdayNotification {
  id               String    @id @default(uuid())
  birthdayId       String
  /// Denormalizado a propósito: filtrar/indexar por guild sin join,
  /// y defensa en profundidad si se consulta esta tabla directamente.
  guildId          String
  notificationDate DateTime  @db.Date
  sentAt           DateTime?
  status           String    @default("pending")
  errorMessage     String?

  birthday Birthday @relation(fields: [birthdayId], references: [id], onDelete: Cascade)

  @@unique([birthdayId, notificationDate])
  @@index([guildId])
  @@map("birthday_notifications")
}

/// Recordatorio personalizado (no cumpleaños) con anticipación configurable.
model Reminder {
  id            String   @id @default(uuid())
  guildId       String
  title         String
  description   String?
  targetDate    DateTime @db.Date
  channelId     String?
  daysBefore    Int      @default(1)
  /// "daily": avisa todos los días desde daysBefore hasta el día del evento.
  /// "once": avisa una sola vez, exactamente daysBefore días antes.
  repeatMode    String   @default("daily")
  customMessage String?
  imageUrl      String?
  color         Int?
  isActive      Boolean  @default(true)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guild         Guild                  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  creator       User                   @relation(fields: [createdBy], references: [id])
  notifications ReminderNotification[]

  @@index([guildId, targetDate])
  @@map("reminders")
}

/// Registro idempotente de un aviso de recordatorio enviado. El índice único
/// (reminderId, notificationDate) impide el doble envío en el mismo día.
model ReminderNotification {
  id               String    @id @default(uuid())
  reminderId       String
  guildId          String
  notificationDate DateTime  @db.Date
  sentAt           DateTime?
  status           String    @default("pending")
  errorMessage     String?

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@unique([reminderId, notificationDate])
  @@index([guildId])
  @@map("reminder_notifications")
}

/// Panel publicado en un canal con un botón "Abrir ticket". Una fila = un
/// mensaje publicado (no hay reenvío/edición, para simplificar el alcance).
model TicketPanel {
  id              String   @id @default(uuid())
  guildId         String
  channelId       String
  messageId       String
  title           String
  description     String?
  color           Int?
  buttonLabel     String   @default("Abrir ticket")
  buttonEmoji     String   @default("🎫")
  buttonStyle     String   @default("primary")
  welcomeMessage  String?
  /// Roles que ven y atienden los tickets de este panel, además de los
  /// roles con Administrador / Administrar servidor (que siempre los ven).
  staffRoleIds    String[] @default([])
  /// Si no está vacío, solo quien tenga al menos uno de estos roles puede
  /// abrir un ticket desde este panel.
  requiredRoleIds String[] @default([])
  /// Categoría donde se crean los canales; si es null usa la de GuildSettings.
  categoryId      String?
  createdBy       String
  createdAt       DateTime @default(now())

  guild   Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  creator User     @relation(fields: [createdBy], references: [id])
  tickets Ticket[]

  @@index([guildId])
  @@map("ticket_panels")
}

/// Canal privado de soporte abierto por un miembro desde un panel.
model Ticket {
  id                    String    @id @default(uuid())
  guildId               String
  panelId               String?
  channelId             String    @unique
  discordUserId         String
  displayName           String
  status                String    @default("open")
  createdAt             DateTime  @default(now())
  closedAt              DateTime?
  closedByDiscordUserId String?

  guild Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  panel TicketPanel? @relation(fields: [panelId], references: [id], onDelete: SetNull)

  @@index([guildId, status])
  @@map("tickets")
}

/// Panel de roles por reacción: un mensaje publicado donde cada emoji da un
/// rol. Las reacciones las procesa apps/gateway (el webhook de interacciones
/// no recibe eventos de reacción). Igual que TicketPanel, no hay edición.
model ReactionRolePanel {
  id          String   @id @default(uuid())
  guildId     String
  channelId   String
  messageId   String   @unique
  title       String
  description String?
  color       Int?
  /// "multiple": puede tener varios roles del panel a la vez.
  /// "single": al elegir uno se le quitan los demás roles del panel.
  mode        String   @default("multiple")
  createdBy   String
  createdAt   DateTime @default(now())

  guild   Guild                @relation(fields: [guildId], references: [id], onDelete: Cascade)
  creator User                 @relation(fields: [createdBy], references: [id])
  options ReactionRoleOption[]

  @@index([guildId])
  @@map("reaction_role_panels")
}

model ReactionRoleOption {
  id       String  @id @default(uuid())
  panelId  String
  /// Tal como se muestra en Discord: "🎮" o "<:nombre:123>".
  emoji    String
  /// Clave de comparación contra el evento del gateway: el emoji unicode
  /// sin variation selectors, o el id si es un emoji custom.
  emojiKey String
  roleId   String
  label    String?
  position Int

  panel ReactionRolePanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@unique([panelId, emojiKey])
  @@map("reaction_role_options")
}
