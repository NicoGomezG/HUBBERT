# Supabase → Project Settings → Database → Connection string
# "Transaction" pooler (puerto 6543) — usado en runtime por la app.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa (puerto 5432) — solo la usan las migraciones de Prisma.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Discord Developer Portal → tu aplicación → OAuth2 / Bot
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""

# Discord Developer Portal → tu aplicación → General Information → Public Key.
# Verifica la firma de los comandos slash (/api/discord/interactions).
DISCORD_PUBLIC_KEY=""

# Cualquier string random — protege /api/cron/birthdays-monthly de
# invocaciones externas (Vercel Cron lo envía automático),
# /api/discord/register-commands al registrar los comandos, y el GET de
# /api/cron/birthdays para pruebas manuales (curl).
CRON_SECRET=""

# Upstash → tu proyecto QStash → Request Builder / API Details.
# QSTASH_TOKEN solo se usa para crear el schedule (una vez, vía API/dashboard),
# no lo necesita el runtime. Las signing keys sí las necesita el endpoint
# /api/cron/birthdays (POST) para verificar que la request viene de QStash.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
